# Example environment variables for local development
# Copy this to .env and fill in values. Do NOT commit .env with secrets.

# Local MongoDB (for development)
# MONGODB_URI="mongodb://localhost/ablespace"

# MongoDB Atlas (for production/Render deployment)
# Replace <username>, <password>, and <cluster-name> with your actual values
# Important: Make sure your IP address is whitelisted in MongoDB Atlas Network Access
# For Render: You need to allow 0.0.0.0/0 (all IPs) OR add Render's specific IP to the whitelist
# See: https://www.mongodb.com/docs/atlas/security-whitelist/
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/ablespace?retryWrites=true&w=majority&ssl=true"

# Port configuration (Render will automatically set this)
# PORT=3000
